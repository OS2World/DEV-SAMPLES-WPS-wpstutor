/*
 * Class Creation and Initialization
 */

SOMClass * SOMLINK M_WPSTutorialNewClass (integer4 somtmajorVersion,
		integer4 somtminorVersion)
{
    SOMClass *result;

    if (_M_WPSTutorial && _somCheckVersion(_M_WPSTutorial, somtmajorVersion, somtminorVersion))
          return _M_WPSTutorial;
    M_WPDataFileNewClass(M_WPDataFile_MajorVersion,M_WPDataFile_MinorVersion);	/* static reference */
    result = somBuildClass(0xFFFFFFFF,&M_WPSTutorialSCI, somtmajorVersion, somtminorVersion);
    M_WPSTutorial_parent_M_WPDataFile_wpclsUnInitData_resolved = 
	somParentNumResolve(M_WPSTutorialCClassData.parentMtab, 1, M_WPObjectClassData.wpclsUnInitData); 
    M_WPSTutorial_parent_M_WPDataFile_wpclsQueryTitle_resolved = 
	somParentNumResolve(M_WPSTutorialCClassData.parentMtab, 1, M_WPObjectClassData.wpclsQueryTitle); 
