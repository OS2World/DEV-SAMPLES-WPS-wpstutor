/*
 * Class Creation and Initialization
 */

SOMClass * SOMLINK WPSTutorialNewClass (integer4 somtmajorVersion,
		integer4 somtminorVersion)
{
    SOMClass *result;

    if (_WPSTutorial && _somCheckVersion(_WPSTutorial, somtmajorVersion, somtminorVersion))
          return _WPSTutorial;
    WPDataFileNewClass(WPDataFile_MajorVersion,WPDataFile_MinorVersion);	/* static reference */
    /* Explicit metaclass, so get it */ 
    M_WPSTutorialNewClass(M_WPSTutorial_MajorVersion,M_WPSTutorial_MinorVersion);	/* static reference */
    result = somBuildClass(0xFFFFFFFF,&WPSTutorialSCI, somtmajorVersion, somtminorVersion);
    WPSTutorial_parent_WPDataFile_wpUnInitData_resolved = 
	somParentNumResolve(WPSTutorialCClassData.parentMtab, 1, WPObjectClassData.wpUnInitData); 
    WPSTutorial_parent_WPDataFile_wpUnlockObject_resolved = 
	somParentNumResolve(WPSTutorialCClassData.parentMtab, 1, WPObjectClassData.wpUnlockObject); 
    WPSTutorial_parent_WPDataFile_wpSwitchTo_resolved = 
	somParentNumResolve(WPSTutorialCClassData.parentMtab, 1, WPObjectClassData.wpSwitchTo); 
    WPSTutorial_parent_WPDataFile_wpSetup_resolved = 
	somParentNumResolve(WPSTutorialCClassData.parentMtab, 1, WPObjectClassData.wpSetup); 
    WPSTutorial_parent_WPDataFile_wpSetType_resolved = 
